<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/widget_background"
    android:padding="8dp"
    android:gravity="center_vertical">

    <!-- Left side brand search bar button -->
    <LinearLayout
        android:id="@+id/widget_search_bar"
        android:layout_width="0dp"
        android:layout_height="38dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:background="@drawable/widget_search_bg"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Lumi Note"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" 🚀 Quick Capture..."
            android:textColor="#80A0B0C0"
            android:textSize="11sp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>

    <View
        android:layout_width="8dp"
        android:layout_height="match_parent" />

    <!-- Action Buttons -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Voice button -->
        <ImageButton
            android:id="@+id/btn_widget_voice"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_widget_mic"
            android:tint="#0A84FF"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:contentDescription="Voice Capture"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp" />

        <!-- Add button -->
        <ImageButton
            android:id="@+id/btn_widget_add"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/widget_button_bg"
            android:src="@drawable/ic_widget_add"
            android:tint="#30D158"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:contentDescription="Text Capture"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp" />
    </LinearLayout>
</LinearLayout>
